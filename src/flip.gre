    <Properties>
        <Property name="horiz" nameUI="Horizontal" type="bool" ini="1" step="1" glValue="true"/>
        <Property name="vert" nameUI="Vertical" type="bool" ini="0" step="1" glValue="true"/>

        </Properties>
  </ShaderEffect>
